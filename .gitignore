bin/
obj/
*.user
*.suo
.vs/
.idea/
.vscode/

# Per-developer csproj override pointing at the local RWT build folder
# (see Source/Local.props.example).
Local.props
# The Six Labors licence key a Release build reads; each builder uses their own.
*.lic

# Build output of deploy.ps1 — regenerable from sources.
Deploy/
# The coordinator's host setup names this network; "Deploy/" covers it only where git ignores case.
/coordinator/deploy/

# Release zips assembled by deploy.ps1 — large binary artifacts,
# uploaded to GitHub Releases rather than tracked.
Releases/

# Manual source-zip backups at repo root (e.g. "Source ServerAddon 3.zip") — snapshots, not tracked source.
/*.zip

# Per-user server runtime data folders, in case the dev runs the
# Deploy build in-place during smoke tests. Anchored to repo root
# (leading /) so they don't catch identically-named tracked folders
# under Templates/ or Source/.
/Assets/
/Backups/
/Configs/
/Logs/
/Temp/
/kmh-data/
/Source/Assets/*
!/Source/Assets/Icons/
!/Source/Assets/Fonts/
/Source/Backups/
/Source/Configs/
/Source/Logs/
/Source/Temp/
/Source/kmh-data/

# Runtime folders a server run drops wherever it is launched. gitignore is case-sensitive, so these PascalCase
# names need their own entries - lowercase /kmh-data/ above does not cover them.
KMH-Data/
KMH-Data-Backups/
kmh-extensions/
.rwt-runtime/

# get-media-tools downloads beside itself by default, so running it in place drops ~270 MB of ffmpeg here.
Templates/media-tools/Tools/

Thumbs.db
.DS_Store
