<Project Sdk="Microsoft.NET.Sdk">

  <!-- One build per RWT server generation (dotnet build -p:RwtFlavor=Old|New|RT):
         Old = the KMHServerAddon.exe launcher   (Shared/TCPNetwork,    26.5.24.1)
         New = a library payload                 (RTShared + GameServer, 26.6.9.1)
         RT  = a library payload                 (RTShared + RTServer,   26.7.25.1+)
       The launcher embeds both payloads and loads whichever matches the server beside
       it, so ONE exe serves every version. Build payloads BEFORE the launcher. -->

  <PropertyGroup>
    <RwtFlavor Condition="'$(RwtFlavor)' == ''">Old</RwtFlavor>
    <!-- RWT 26.10.20.1 builds its server for .NET 10 and it runs in this process; older RWT servers (.NET 8) load unchanged. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>KMHServerAddon</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.3.1</Version>
    <InformationalVersion>1.3.1+rel-283</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyVersion>1.3.1.0</AssemblyVersion>
    <FileVersion>1.3.1.0</FileVersion>
    <IntermediateOutputPath>obj\$(RwtFlavor)\$(Configuration)\</IntermediateOutputPath>
    <!-- Shipped binaries name no folder on the machine that built them. -->
    <PathMap>$(MSBuildProjectDirectory)=/_/</PathMap>

    <!-- Same RID set the RWT server uses so the addon publishes across
         the same platforms players already get the server for. -->
    <RuntimeIdentifiers>win-x64;win-x86;linux-x64;linux-arm;linux-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <!-- A self-contained bundle ships the runtime RWT's server runs on too; SDK 9.0.306 defaulted net8.0 to 8.0.21,
       ten security releases behind. Framework-dependent builds keep rolling forward on the host's runtime. -->
  <PropertyGroup Condition="'$(SelfContained)' == 'true'">
    <RuntimeFrameworkVersion>10.0.13</RuntimeFrameworkVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RwtFlavor)' == 'Old'">
    <OutputType>Exe</OutputType>
    <AssemblyName>KMHServerAddon</AssemblyName>
    <DefineConstants>$(DefineConstants);RWT_OLD</DefineConstants>
    <!-- The real entry point is Bootstrap.Main - an RWT-free shim that probes
         which server generation sits next to the exe before touching any RWT
         type, then either runs Main_ here (old) or the embedded payload (new). -->
    <StartupObject>KMHServerAddon.Bootstrap</StartupObject>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RwtFlavor)' == 'New'">
    <OutputType>Library</OutputType>
    <AssemblyName>KMHAddon.RTShared</AssemblyName>
    <DefineConstants>$(DefineConstants);RWT_NEW</DefineConstants>
    <OutputPath>bin\payload</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RwtServerBuildPath Condition="'$(RwtServerBuildPath)' == ''">$(MSBuildThisFileDirectory)..\..\rwt-26.6.9.1\Server</RwtServerBuildPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RwtFlavor)' == 'RT'">
    <OutputType>Library</OutputType>
    <AssemblyName>KMHAddon.RTServer</AssemblyName>
    <!-- RWT_NEW too: still RTShared/RTNetwork, so shims keyed to it apply. RWT_RT only picks the renamed server. -->
    <DefineConstants>$(DefineConstants);RWT_NEW;RWT_RT</DefineConstants>
    <OutputPath>bin\payload</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RwtServerBuildPath Condition="'$(RwtServerBuildPath)' == ''">$(MSBuildThisFileDirectory)..\..\rwt-RTServer\Server</RwtServerBuildPath>
  </PropertyGroup>

  <!-- The launcher embeds each payload that has been built (build New + RT before Old for release; a plain dev
       build still works without them). -->
  <ItemGroup Condition="'$(RwtFlavor)' == 'Old' and Exists('bin\payload\KMHAddon.RTShared.dll')">
    <EmbeddedResource Include="bin\payload\KMHAddon.RTShared.dll" LogicalName="KMHAddon.RTShared.dll" />
  </ItemGroup>
  <ItemGroup Condition="'$(RwtFlavor)' == 'Old' and Exists('bin\payload\KMHAddon.RTServer.dll')">
    <EmbeddedResource Include="bin\payload\KMHAddon.RTServer.dll" LogicalName="KMHAddon.RTServer.dll" />
  </ItemGroup>

  <!-- Committed source only: @(Compile) also carries obj/ files regenerated every build, which are always newer
       than the payloads and would make the staleness check below cry wolf on a clean release build. -->
  <ItemGroup Condition="'$(RwtFlavor)' == 'Old'">
    <KmhPayloadSource Include="**\*.cs" Exclude="obj\**\*.cs;bin\**\*.cs;KMH.Sdk.Server\**\*.cs" />
  </ItemGroup>

  <!-- New-generation servers run an EMBEDDED payload. If source changed since a payload was last built, the
       launcher ships stale code (missing handlers/features - e.g. a "No handler for kind" flood). Warn loudly. -->
  <Target Name="WarnStalePayload" BeforeTargets="Build" Condition="'$(RwtFlavor)' == 'Old' and Exists('bin\payload\KMHAddon.RTShared.dll')" Inputs="@(KmhPayloadSource)" Outputs="bin\payload\KMHAddon.RTShared.dll">
    <Warning Text="KMHAddon.RTShared.dll (the 26.6.x payload) is OLDER than source - rebuild it before releasing: dotnet build -p:RwtFlavor=New. A stale payload ships old code to new-generation servers (e.g. missing message handlers)." />
  </Target>
  <Target Name="WarnStaleRtPayload" BeforeTargets="Build" Condition="'$(RwtFlavor)' == 'Old' and Exists('bin\payload\KMHAddon.RTServer.dll')" Inputs="@(KmhPayloadSource)" Outputs="bin\payload\KMHAddon.RTServer.dll">
    <Warning Text="KMHAddon.RTServer.dll (the renamed-assembly payload) is OLDER than source - rebuild it before releasing: dotnet build -p:RwtFlavor=RT. A stale payload ships old code to RTServer-generation servers." />
  </Target>
  <!-- KmhVersion.Build feeds the handshake (via KmhProtocol.BuildVersion) and has shipped stale before, so fail
       the build rather than let the handshake report a version that wasn't built. -->
  <Target Name="VerifyBuildVersion" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_VersionFile>KmhVersion.cs</_VersionFile>
      <_VersionText>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\$(_VersionFile)'))</_VersionText>
      <_DeclaredBuildVersion>$([System.Text.RegularExpressions.Regex]::Match($(_VersionText), 'Build\s*=\s*"([^"]*)"').Groups[1].Value)</_DeclaredBuildVersion>
    </PropertyGroup>
    <Error Condition="'$(_DeclaredBuildVersion)' != '$(Version)'" Text="KmhVersion.Build is &quot;$(_DeclaredBuildVersion)&quot; but the project version is &quot;$(Version)&quot;. Update $(_VersionFile) so the handshake reports the version actually shipped." />
  </Target>
  <!-- AssemblyVersion is 1.3.1.0 for every rel of v1.3.1, so the rel tag is the only thing separating them and a
       release check can only trust it if the binary and the source agree. -->
  <Target Name="VerifyBuildTag" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_TagText>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\KmhVersion.cs'))</_TagText>
      <_DeclaredTag>$([System.Text.RegularExpressions.Regex]::Match($(_TagText), 'BuildTag\s*=\s*"([^"]*)"').Groups[1].Value)</_DeclaredTag>
      <_InfoTag>$([System.Text.RegularExpressions.Regex]::Match('$(InformationalVersion)', '\+(.*)$').Groups[1].Value)</_InfoTag>
    </PropertyGroup>
    <Error Condition="'$(_DeclaredTag)' != '$(_InfoTag)'" Text="KmhVersion.BuildTag is &quot;$(_DeclaredTag)&quot; but InformationalVersion carries &quot;$(_InfoTag)&quot;. They are what tells two 1.3.1.0 builds apart - bump both together." />
  </Target>

  <!-- A launcher built without a payload silently loses support for that generation, so say so at build time. -->
  <Target Name="WarnMissingPayloads" BeforeTargets="Build" Condition="'$(RwtFlavor)' == 'Old'">
    <Warning Condition="!Exists('bin\payload\KMHAddon.RTShared.dll')" Text="No KMHAddon.RTShared.dll payload - this launcher will NOT support 26.6.x servers. Build it first: dotnet build -p:RwtFlavor=New." />
    <Warning Condition="!Exists('bin\payload\KMHAddon.RTServer.dll')" Text="No KMHAddon.RTServer.dll payload - this launcher will NOT support RTServer-generation servers. Build it first: dotnet build -p:RwtFlavor=RT." />
  </Target>

  <!-- Harmony bundled with our addon - RWT server doesn't ship it.
       Private=true so 0Harmony.dll lands in our build output and the
       single addon publish carries everything the launcher needs. -->
  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
    <!-- Discord bridge dependency. Bundled with the addon so a single
         publish carries everything. Bridge is opt-in via
         Config/Discord/DiscordConfig.json - when that file is absent the
         dependency is loaded but the bot never starts, so cold-start cost
         is minimal. -->
    <PackageReference Include="Discord.Net" Version="3.16.0" />
    <!-- Release builds need a Six Labors Community key (free for source-available projects): see Local.props.example. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="4.1.3" />
    <!-- The leaderboard PNG for Discord, drawn here so it needs no Global; the same versions Global draws it with. -->
    <PackageReference Include="SixLabors.Fonts" Version="3.2.0" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="3.1.3" />
  </ItemGroup>

  <!-- Inter (SIL OFL 1.1) for the leaderboard PNG, embedded with its licence so every host draws the same bytes. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\Fonts\Inter-*.ttf;Assets\Fonts\Inter-LICENSE.txt" LogicalName="KMH.Fonts.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Public SDK project for extension authors. Built alongside the
       addon; the resulting KMH.Sdk.Server.dll is shipped in Deploy/
       and downstream extensions reference it (not the addon itself,
       which keeps internals out of their compile-time surface). -->
  <ItemGroup>
    <ProjectReference Include="KMH.Sdk.Server\KMH.Sdk.Server.csproj" />
  </ItemGroup>

  <!-- Discord embed icons. Source/Assets/Icons/ is the committed source set ONLY - it is
       deliberately NOT copied next to the exe. On every build the icons are written into
       KMH-Data/Icons/ instead (Old flavor = the shipped exe; the New payload runs inside
       it and shares its folder, so it needs no copy). KMH-Data/Icons is the single folder
       the addon reads at runtime (KmhDataPaths.IconsDir) and the one packaged in every
       release - so owners get a populated, ready-to-edit icons folder out of the box and
       there's no Assets/Icons fallback to reason about. Drop/replace PNGs in
       Source/Assets/Icons/ (filenames in its README) and rebuild. PascalCase KMH-Data
       matches KmhDataPaths so the running exe finds it as-is (incl. on Linux). -->
  <ItemGroup>
    <KmhDataIcon Include="Assets\Icons\**\*" />
  </ItemGroup>

  <!-- ALSO embedded, in every flavor, because staging only fills a folder the zip then carries: an owner who
       upgrades by replacing the exe, or any setup script that runs against an already-booted folder, never
       receives the PNGs at all. DiscordIconAssets writes back whichever stock icon is missing at boot, so the
       icons survive an in-place upgrade instead of quietly disappearing from Discord embeds. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\Icons\*.png;Assets\Icons\*.txt" LogicalName="KMH.Icons.%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="StageKmhDataIconsBuild" AfterTargets="Build" Condition="'$(RwtFlavor)' == 'Old'">
    <Copy SourceFiles="@(KmhDataIcon)" DestinationFiles="@(KmhDataIcon->'$(OutDir)KMH-Data\Icons\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="StageKmhDataIconsPublish" AfterTargets="Publish" Condition="'$(RwtFlavor)' == 'Old'">
    <Copy SourceFiles="@(KmhDataIcon)" DestinationFiles="@(KmhDataIcon->'$(PublishDir)KMH-Data\Icons\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <!-- Newtonsoft.Json is referenced Private=False (framework-dependent builds get it from RWT's own folder).
       A self-contained folder build has no RWT beside it at publish time, so stage Newtonsoft here or it starts
       up missing that dependency. Same DLL RWT ships, so no version drift. -->
  <!-- Only when the publish brought none: Discord.Net already publishes 13.0.3, and RWT 26.5's 11.0.1 over it is CVE-2024-21907. -->
  <Target Name="StageNewtonsoftForSelfContained" AfterTargets="Publish" Condition="'$(RwtFlavor)' == 'Old' and '$(SelfContained)' == 'true' and Exists('$(RwtServerBuildPath)\Newtonsoft.Json.dll') and !Exists('$(PublishDir)Newtonsoft.Json.dll')">
    <Copy SourceFiles="$(RwtServerBuildPath)\Newtonsoft.Json.dll" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- The SDK project lives at Source/KMH.Sdk.Server/ - a sub-folder
       of this csproj's directory. MSBuild's default Compile glob
       (**/*.cs) would otherwise pull the SDK's source AND its
       generated obj/Debug/net8.0/*.cs (AssemblyInfo etc.) into the
       addon build, producing duplicate-attribute errors. Exclude
       the SDK folder explicitly. -->
  <ItemGroup>
    <Compile Remove="KMH.Sdk.Server\**\*.cs" />
    <Content Remove="KMH.Sdk.Server\**" />
    <EmbeddedResource Remove="KMH.Sdk.Server\**" />
    <None Remove="KMH.Sdk.Server\**" />
  </ItemGroup>

  <!--
    RWT server assemblies referenced from a local server-from-source build.
    Private=False so we DO NOT copy/redistribute RWT's DLLs - the addon
    expects to live in a folder next to RWT's already-built DLLs.

    Update RwtServerBuildPath when targeting a different RWT version (e.g.
    upstream/production once aligned, or whichever fork you're building
    against). Compile-time only - never bundled in our output.
  -->
  <PropertyGroup>
    <!-- Compile-time HintPath root for the RWT server's Debug (multi-file) build output. Point it at your local
         RWT 26.5.24.1 build. Override without editing this file: set $env:RwtServerBuildPath, or add the path in
         Source/Local.props (gitignored, imported below). -->
    <RwtServerBuildPath Condition="'$(RwtServerBuildPath)' == ''">$(MSBuildThisFileDirectory)..\..\rwt-26.5.24.1\Source\Server\bin\Debug\net8.0</RwtServerBuildPath>
  </PropertyGroup>

  <Import Project="Local.props" Condition="Exists('Local.props')" />

  <!-- RWT server assemblies, compile-time only (Private=False), never copied into our output. At runtime the exe
       loads them from the RWT server folder it runs in, so the admin drops KMHServerAddon.exe there and runs it. -->
  <ItemGroup>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(RwtServerBuildPath)\Newtonsoft.Json.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <!-- The server assembly itself was renamed GameServer -> RTServer, so it is referenced per flavor. -->
  <ItemGroup Condition="'$(RwtFlavor)' != 'RT'">
    <Reference Include="GameServer">
      <HintPath>$(RwtServerBuildPath)\GameServer.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(RwtFlavor)' == 'RT'">
    <Reference Include="RTServer">
      <HintPath>$(RwtServerBuildPath)\RTServer.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(RwtFlavor)' == 'Old'">
    <Reference Include="Shared">
      <HintPath>$(RwtServerBuildPath)\Shared.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="TCPNetwork">
      <HintPath>$(RwtServerBuildPath)\TCPNetwork.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(RwtFlavor)' == 'New' or '$(RwtFlavor)' == 'RT'">
    <Reference Include="RTShared">
      <HintPath>$(RwtServerBuildPath)\RTShared.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RTNetwork">
      <HintPath>$(RwtServerBuildPath)\RTNetwork.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>
