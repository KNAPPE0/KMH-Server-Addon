<Project Sdk="Microsoft.NET.Sdk">

  <!-- Public SDK for server-side KMH extensions. Stable contract that
       absorbs RWT release drift so extensions don't recompile per upgrade. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>KMH.Sdk.Server</RootNamespace>
    <AssemblyName>KMH.Sdk.Server</AssemblyName>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.3.1</Version>
    <InformationalVersion>1.3.1+rel-282</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- Shipped binaries name no folder on the machine that built them. -->
    <PathMap>$(MSBuildProjectDirectory)=/_/</PathMap>
    <AssemblyVersion>1.3.1.0</AssemblyVersion>
    <FileVersion>1.3.1.0</FileVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- NuGet metadata. `dotnet pack -c Debug` emits .nupkg + .snupkg under Releases/. -->
  <PropertyGroup>
    <PackageId>KMH.Sdk.Server</PackageId>
    <Title>KMH Server SDK</Title>
    <Description>Public API for writing server-side extensions that plug into KMH Server Addon for RimWorld Together. Stable contract that absorbs RWT release upgrades.</Description>
    <Authors>KNAPPE0</Authors>
    <Company>KMH Project</Company>
    <Product>KMH Server SDK</Product>
    <Copyright>Copyright (c) 2026 KNAPPE0</Copyright>
    <PackageTags>rimworld;rimworld-together;rwt;kmh;multiplayer;sdk</PackageTags>
    <PackageProjectUrl>https://github.com/KNAPPE0/KMH-Server-Addon</PackageProjectUrl>
    <RepositoryUrl>https://github.com/KNAPPE0/KMH-Server-Addon</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>EXTENSIONS.md</PackageReadmeFile>
    <PackageReleaseNotes>1.3.0 - Frontier outposts, Roadworks, Player Mail, chat and communications, world media, and site archetypes. New SDK surface: Hooks for vetoing pending actions, ChatMessagePosted and MailSent events, snapshot/season ops events, and site ownership plus Frontier fields on the player and site records. Additive only - every 1.2.x public API keeps its signature and its meaning. 1.2.2 - Compatibility release for the RWT build that renamed the server assembly (GameServer.dll -> RTServer.dll) and its namespaces: KMH now identifies the RWT server by its contents instead of its file name, ships a matching payload for the renamed generation, invalidates a stale .rwt-runtime cache after an RWT update, and reports exactly what it searched for when no server is found. 1.2.1 - Treasury hotfix: fungible food/resource stacking + one-time consolidation of legacy vault fragments, complex-classified items (e.g. eltex) deposit via payload fallback, payload withdraws no longer capped at 10. 1.2.0 - Economy integrity update (auto treasury reset on new save, custom-site value-underreport hardening, disabled-feature dashboard clarity). 1.1.1 - Transport hardening hotfix (loopback-by-default API, auth, connection caps, failed-auth throttle, reconnect-race fix, security test harness). See EXTENSIONS.md.</PackageReleaseNotes>
    <PackageOutputPath>..\..\Releases</PackageOutputPath>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE"        Pack="true" PackagePath="\" />
    <None Include="..\..\EXTENSIONS.md"  Pack="true" PackagePath="\" />
  </ItemGroup>


  <!-- Stamped with the rel too, and nothing else would catch this copy drifting. -->
  <Target Name="VerifyBuildTag" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_TagText>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\..\KmhVersion.cs'))</_TagText>
      <_DeclaredTag>$([System.Text.RegularExpressions.Regex]::Match($(_TagText), 'BuildTag\s*=\s*"([^"]*)"').Groups[1].Value)</_DeclaredTag>
      <_InfoTag>$([System.Text.RegularExpressions.Regex]::Match('$(InformationalVersion)', '\+(.*)$').Groups[1].Value)</_InfoTag>
    </PropertyGroup>
    <Error Condition="'$(_DeclaredTag)' != '$(_InfoTag)'" Text="KmhVersion.BuildTag is &quot;$(_DeclaredTag)&quot; but InformationalVersion carries &quot;$(_InfoTag)&quot;. They are what tells two 1.3.1.0 builds apart - bump both together." />
  </Target>

</Project>
