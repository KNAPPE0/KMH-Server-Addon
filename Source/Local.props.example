<!--
  Per-developer build-path override. Copy this file to Local.props
  (next to KMHServerAddon.csproj) and edit the path inside to point
  at your local RWT 26.5.24.1 build output.

  Local.props is gitignored so your local override never leaks into
  commits.

  Example (Windows):
    <RwtServerBuildPath>C:\src\RimworldTogether\Source\Server\bin\Debug\net8.0</RwtServerBuildPath>

  Example (macOS / Linux):
    <RwtServerBuildPath>/home/me/src/RimworldTogether/Source/Server/bin/Debug/net8.0</RwtServerBuildPath>

  Release builds also need a Six Labors licence key, which ImageSharp checks at build time. It is free for
  source-available projects: apply at https://licensing.sixlabors.com/ naming the assemblies KMHServerAddon,
  KMHAddon.RTShared and KMHAddon.RTServer. Point SixLaborsLicenseFile at the key file below, or set the SixLaborsLicenseKey environment
  variable. Debug builds only warn without one.

  Build steps after this file exists:
    1) Make sure your RWT 26.5.24.1 build has run successfully and the
       folder above contains GameServer.dll, Shared.dll, TCPNetwork.dll,
       and Newtonsoft.Json.dll.
    2) cd KMH-Server-Addon/Source
    3) dotnet build -c Debug
-->
<Project>
  <PropertyGroup>
    <RwtServerBuildPath>C:\path\to\rwt\Source\Server\bin\Debug\net8.0</RwtServerBuildPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(SixLaborsLicenseKey)' == '' and Exists('C:\path\to\sixlabors.lic')">
    <SixLaborsLicenseFile>C:\path\to\sixlabors.lic</SixLaborsLicenseFile>
  </PropertyGroup>
</Project>
